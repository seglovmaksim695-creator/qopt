# Source distribution: package, tests and the redistributable benchmark inputs the tests need.
include README.md README_RU.md CHANGELOG.md LICENSE NOTICE CITATION.cff
include bench_qc/*.qc bench_qc/SOURCES.md
include results/best/strict/tof_3.qasm
recursive-include tests *.py
recursive-include tests/data *.qasm *.qc *.json
prune _build
prune results/hardware
global-exclude *.pyc __pycache__ *hwb*.qc *hwb*.qasm
prune qoptct/contrib/c2/out
include results/crypto/*.qasm results/crypto/*.qc results/crypto/*.json
include results/qualtran/*.json
include scripts/build_qualtran_registry.py
include docs/QUALTRAN*.md
include results/dyadic/*.json results/auto/*.json results/projectq/*.json
recursive-include results/loop *.json *.jsonl *.md *.qasm
include scripts/build_*_registry.py scripts/dyadic_runs.py scripts/projectq_dyadic_runs.py
include docs/FOREIGN.md docs/QISKIT.md docs/PROJECTQ.md docs/DYADIC.md docs/AUTO.md docs/LOOP.md
